load("@rules_python//python:py_test.bzl", "py_test")

filegroup(
    name = "library_readme",
    srcs = ["@rules_layer_optimizer//:README.md"],
)

[
    py_test(
        name = backend + "_backend_test",
        srcs = ["backend_equivalence_test.py"],
        args = [
            "$(rootpath //" + backend + ":image)",
            "$(rootpath //" + backend + ":img_layout)",
        ],
        data = [
            "//" + backend + ":image",
            "//" + backend + ":img_layout",
            "//basic_layers:optimized",
            "//basic_layers:optimized_optimization_plan",
            "//basic_layers:optimized_packages_flat_tars",
            "//python_image:partitioned_layers_source_first",
        ],
        main = "backend_equivalence_test.py",
    )
    for backend in [
        "python_image",
        "rules_python_image",
    ]
]
