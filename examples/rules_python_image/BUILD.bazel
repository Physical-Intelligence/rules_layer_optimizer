load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_layer_optimizer//layers:defs.bzl", "layer_group")
load("@rules_layer_optimizer//layers:distroless.bzl", "optimized_layers")
load("@rules_layer_optimizer//python:inference.bzl", "env_file", "env_inference")
load("@rules_layer_optimizer//python:rules_python.bzl", "pip_layer_reducer", "py_image_layer")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//:archive_test.bzl", "archive_test")
load("//:oci_load.bzl", "oci_load")
load("//python_image:tags_test.bzl", "tags_test")
load("//shared_dependencies:sharing_test.bzl", "sharing_test")

py_binary(
    name = "app",
    srcs = ["app.py"],
    legacy_create_init = False,
    deps = [
        "@pip//backports_strenum",
        "@pip//backports_tarfile",
        "@pip//colorama",
        "@pip//google_crc32c",
    ],
)

py_binary(
    name = "other",
    srcs = ["app.py"],
    legacy_create_init = False,
    main = "app.py",
    deps = [
        "@pip//backports_strenum",
        "@pip//backports_tarfile",
        "@pip//colorama",
        "@pip//google_crc32c",
    ],
)

py_image_layer(
    name = "app_layers",
    binary = ":app",
    strip_prefix = "rules_python_image/app",
)

pip_layer_reducer(
    name = "other_layers",
    deps = [":other"],
)

sharing_test(
    name = "sharing_test",
    expected_count = 4,
    other = ":other_layers",
    target_under_test = ":app_layers_pip",
)

archive_test(
    name = "wheel_contents_test",
    archive = ":app_layers_pip",
    contains = [
        "colorama/__init__.py",
        "colorama-0.4.6.dist-info/METADATA",
        "colorama-0.4.6.dist-info/WHEEL",
        "google_crc32c/_crc32c.cpython-312",
        "google_crc32c.libs/libcrc32c-",
        "backports/tarfile/__init__.py",
        "backports/strenum/__init__.py",
    ],
)

archive_test(
    name = "source_contents_test",
    archive = ":app_layers_source",
    contains = ["app.runfiles/_main/rules_python_image/app.py"],
    excludes = [
        "colorama/__init__.py",
        "/bin/python3.12",
        "_crc32c.cpython-312",
        "/libcrc32c-",
        "backports/tarfile/__init__.py",
        "backports/strenum/__init__.py",
        "colorama-0.4.6.dist-info/METADATA",
    ],
)

optimized_layers(
    name = "optimized",
    compress = "gzip",
    groups = [
        layer_group(
            name = "interpreter",
            targets = [":app_layers_interpreter"],
        ),
        layer_group(
            name = "pip",
            overflow = "flatten",
            targets = [":app_layers_pip"],
        ),
        layer_group(
            name = "source",
            targets = [":app_layers_source"],
        ),
    ],
    layer_budget = 8,
    size_bytes_threshold = 1,
)

env_inference(
    name = "colorama_env",
    env = {"COLORAMA_AVAILABLE": "1"},
    for_deps = ["@packages//colorama"],
)

env_file(
    name = "env",
    base_env = {},
    extra_env = {},
    inferences = [":colorama_env"],
    runfiles_root = "/app.runfiles",
    deps = [":app"],
)

oci_image(
    name = "image",
    base = "@ubuntu",
    entrypoint = ["/app"],
    env = ":env",
    tars = [":optimized"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["rules-layer-optimizer-rules-python:local"],
)

image_manifest(
    name = "img_image",
    base = image("img_ubuntu"),
    entrypoint = ["/app"],
    env_file = ":env",
    layers = [":optimized"],
)

image_load(
    name = "img_load",
    image = ":img_image",
    tag = "docker.io/library/rules-layer-optimizer-rules-python-img:local",
)

filegroup(
    name = "img_layout",
    srcs = [":img_image"],
    output_group = "oci_layout",
    visibility = ["//visibility:public"],
)

write_source_files(
    name = "write_optimization_plan",
    files = {"optimization_plan.json": ":optimized_optimization_plan"},
)

py_image_layer(
    name = "tagged_layers",
    binary = ":app",
    strip_prefix = "rules_python_image/app",
    tags = [
        "caller-policy",
        "manual",
    ],
)

tags_test(
    name = "caller_tags_test",
    expected = [
        "manual",
        "caller-policy",
    ],
    prefix = "tagged_layers",
)
