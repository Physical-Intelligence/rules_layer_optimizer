load("@aspect_bazel_lib//lib:tar.bzl", "mtree_mutate", "mtree_spec", "tar")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_layer_optimizer//layers:defs.bzl", "layer_group")
load("@rules_layer_optimizer//layers:distroless.bzl", "optimized_layers")
load("@rules_layer_optimizer//python:defs.bzl", "py_image_layer")
load("@rules_layer_optimizer//python:inference.bzl", "env_file", "env_inference")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:oci_load.bzl", "oci_load")
load(":interpreter.bzl", "interpreter_path")
load(":tags_test.bzl", "tags_test")

py_binary(
    name = "app",
    srcs = ["app.py"],
    data = [
        ":first_asset",
        ":native_extension",
        ":second_asset",
        ":third_asset",
    ],
    deps = [
        "@packages//backports_strenum",
        "@packages//backports_tarfile",
        "@packages//colorama",
        "@packages//google_crc32c",
    ],
)

mtree_spec(
    name = "interpreter_mtree",
    srcs = ["@python_3_12_x86_64_unknown_linux_gnu//:files"],
)

mtree_mutate(
    name = "interpreter_paths",
    mtree = ":interpreter_mtree",
    package_dir = interpreter_path(),
)

tar(
    name = "interpreter",
    srcs = ["@python_3_12_x86_64_unknown_linux_gnu//:files"],
    compress = "gzip",
    mtree = ":interpreter_paths",
)

py_image_layer(
    name = "app_layers",
    binary = ":app",
    compress = "gzip",
    interpreter_tar = ":interpreter",
    python_toolchain = "@python_interpreters//:current_py_toolchain",
    strip_prefix = "python_image/app",
)

optimized_layers(
    name = "optimized",
    compress = "gzip",
    groups = [
        layer_group(
            name = "interpreter",
            targets = [":interpreter"],
        ),
        layer_group(
            name = "pip",
            overflow = "flatten",
            targets = [":app_layers_pip"],
        ),
        layer_group(
            name = "source",
            targets = [":app_layers_source"],
        ),
    ],
    layer_budget = 8,
    size_bytes_threshold = 1,
)

env_inference(
    name = "colorama_env",
    env = {"COLORAMA_AVAILABLE": "1"},
    for_deps = [
        "@packages//colorama",
        "@packages//google_crc32c",
        "@packages//backports_tarfile",
        "@packages//backports_strenum",
    ],
)

env_file(
    name = "env",
    base_env = {},
    extra_env = {},
    inferences = [":colorama_env"],
    runfiles_root = "/app.runfiles",
    deps = [":app"],
)

oci_image(
    name = "image",
    base = "@ubuntu",
    entrypoint = ["/app"],
    env = ":env",
    tars = [":optimized"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "layers_test",
    srcs = ["layers_test.sh"],
    args = [
        "$(rootpath :app_layers_source)",
        "$(rootpath :env)",
        "$(rootpath :optimized_optimization_plan)",
    ],
    data = [
        ":app_layers_source",
        ":env",
        ":image",
        ":optimized_optimization_plan",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["rules-layer-optimizer-example:local"],
)

image_manifest(
    name = "img_image",
    base = image("img_ubuntu"),
    entrypoint = ["/app"],
    env_file = ":env",
    layers = [":optimized"],
)

image_load(
    name = "img_load",
    image = ":img_image",
    tag = "docker.io/library/rules-layer-optimizer-aspect-img:local",
)

filegroup(
    name = "img_layout",
    srcs = [":img_image"],
    output_group = "oci_layout",
    visibility = ["//visibility:public"],
)

py_image_layer(
    name = "tagged_layers",
    binary = ":app",
    interpreter_tar = ":interpreter",
    python_toolchain = "@python_interpreters//:current_py_toolchain",
    strip_prefix = "python_image/app",
    tags = [
        "caller-tag",
        "manual",
        "no-remote-cache",
    ],
)

tags_test(
    name = "default_tags_test",
    expected = [],
    prefix = "app_layers",
)

tags_test(
    name = "caller_tags_test",
    expected = [
        "manual",
        "no-remote-cache",
        "caller-tag",
    ],
    prefix = "tagged_layers",
)

write_source_files(
    name = "write_optimization_plan",
    files = {"optimization_plan.json": ":optimized_optimization_plan"},
)

write_file(
    name = "first_asset",
    out = "fixtures/first.txt",
    content = ["first"],
)

write_file(
    name = "second_asset",
    out = "fixtures/second.txt",
    content = ["second"],
)

write_file(
    name = "native_extension",
    out = "fixtures/binding.so",
    content = ["native payload"],
)

py_image_layer(
    name = "partitioned_layers",
    binary = ":app",
    compress = "gzip",
    exclude_patterns = ["/fixtures/second[.]txt$"],
    interpreter_tar = ":interpreter",
    python_toolchain = "@python_interpreters//:current_py_toolchain",
    source_layers = {
        "first": ["/fixtures/first[.]txt$"],
        "assets": ["/fixtures/.*[.]txt$"],
        "empty": ["/does_not_exist/"],
    },
    strip_prefix = "python_image/app",
    visibility = ["//visibility:public"],
)

py_test(
    name = "source_layers_test",
    srcs = ["source_layers_test.py"],
    args = [
        "$(rootpath :partitioned_layers_source)",
        "$(rootpath :partitioned_layers_source_first)",
        "$(rootpath :partitioned_layers_source_assets)",
        "$(rootpath :partitioned_layers_source_empty)",
    ],
    data = [
        ":partitioned_layers_source",
        ":partitioned_layers_source_assets",
        ":partitioned_layers_source_empty",
        ":partitioned_layers_source_first",
    ],
)

write_file(
    name = "third_asset",
    out = "fixtures/third.txt",
    content = ["third"],
)
