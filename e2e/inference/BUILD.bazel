load("@rules_layer_optimizer//python:inference.bzl", "env_file", "env_inference")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "app",
    deps = ["@pip//colorama"],
)

env_inference(
    name = "flags",
    env = {"FLAGS": "--second"},
    for_deps = ["@pip//colorama"],
)

env_file(
    name = "env",
    base_env = {"FLAGS": "--first"},
    env_separators = {"FLAGS": " "},
    inferences = [":flags"],
    deps = [":app"],
)

py_test(
    name = "inference_test",
    srcs = ["inference_test.py"],
    args = ["$(rootpath :env)"],
    data = [":env"],
)
