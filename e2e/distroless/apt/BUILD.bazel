load("@rules_layer_optimizer//apt:defs.bzl", "apt_inference", "inferred_apt_deps")
load("@rules_layer_optimizer//inference:defs.bzl", "layer_inference_bundle")
load("@rules_layer_optimizer//layers:defs.bzl", "layer_group")
load("@rules_layer_optimizer//layers:distroless.bzl", "optimized_layers")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":apt_test.bzl", "apt_test")

filegroup(name = "trigger")

filegroup(
    name = "app",
    srcs = [":trigger"],
)

apt_inference(
    name = "bash_runtime",
    for_deps = [":trigger"],
    packages = ["@debs//bash"],
)

layer_inference_bundle(
    name = "runtime",
    inferences = [":bash_runtime"],
)

inferred_apt_deps(
    name = "apt_layers",
    inferences = [":runtime"],
    packages = ["@debs//bash"],
    deps = [":app"],
)

apt_test(
    name = "apt_metadata_test",
    target_under_test = ":apt_layers",
)

optimized_layers(
    name = "optimized",
    compress = "gzip",
    groups = [layer_group(
        name = "apt",
        overflow = "flatten",
        targets = [":apt_layers"],
    )],
    layer_budget = 2,
    size_bytes_threshold = 100,
)

sh_test(
    name = "archive_test",
    srcs = ["archive_test.sh"],
    args = ["$(rootpath :optimized)"],
    data = [":optimized"],
)
